{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genmagang",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "triggers": {
    "crons": [
      "30 9 * * 1-5"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "TELEGRAM_USERS",
      "id": "d43494c059144e459604daf203ca4cad"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_APP_URL": "https://genmagang.web.id",
    "KEMNAKER_PROXY_BASE_URL": "https://api.mobogen.online"
  },
  "routes": [
    {
      "pattern": "genmagang.web.id",
      "custom_domain": true
    },
    {
      "pattern": "www.genmagang.web.id",
      "custom_domain": true
    }
  ]
}
